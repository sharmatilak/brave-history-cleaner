{
  "manifest_version": 3,
  "name": "Brave History Cleaner",
  "version": "1.1.0",
  "description": "Automatically remove browsing history for selected websites.",
  "permissions": [
    "history",
    "storage",
    "tabs",
    "alarms"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Brave History Cleaner"
  },
  "options_page": "options/options.html"
}